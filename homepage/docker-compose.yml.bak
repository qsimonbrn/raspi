services:
  homepage:
    image: ghcr.io/gethomepage/homepage:latest
    container_name: homepage
    restart: unless-stopped

    ports:
      - "3000:3000"

    environment:
      PUID: 1000                 # simon
      PGID: 1000
      # Ab Homepage v1.0 Pflicht: erlaubte Hostnamen, sonst wird der Zugriff
      # mit "Host validation failed" abgewiesen.
      HOMEPAGE_ALLOWED_HOSTS: >-
        192.168.178.80:3000,raspberrypi.local:3000,10.66.66.1:3000,localhost:3000

    # Zugriff auf den Docker-Socket, um Container automatisch zu erkennen.
    # Der Socket gehoert root:docker (GID 991) -- der Container laeuft als
    # UID 1000 und braucht daher die Gruppenmitgliedschaft.
    group_add:
      - "991"

    volumes:
      # Konfiguration liegt IM REPO und ist damit persistent und versioniert.
      # Genau das hat bei Dashy gefehlt.
      - ./config:/app/config
      # Nur lesend -- Homepage muss nichts an Docker aendern.
      - /var/run/docker.sock:/var/run/docker.sock:ro

    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:3000"]
      interval: 1m
      timeout: 10s
      retries: 3
      start_period: 40s

# =============================================================================
#  Zusammengefuehrt am 18.08.2026 aus den .gitignore-Dateien von
#  docker-stacks und raspi-doku.
# =============================================================================

# --- Niemals versionieren ----------------------------------------------------
.env
*.key
*.pem
*_rsa
*_ed25519
secrets*
secrets/

# --- Daten und Laufzeit ------------------------------------------------------
*.db
*.log
*.pid
logs/
**/data/

# --- Vollstaendige Rohausgaben der Bestandsaufnahme --------------------------
# Gross, aendern sich bei jedem Lauf komplett und koennen unbeabsichtigt
# sensible Details enthalten. Die Kennzahlen daneben werden versioniert.
inventar/snapshots/*-voll.txt

# --- Sicherungskopien --------------------------------------------------------
*.bak
*.bak-*
*.old

# --- Betriebssystem und Editor -----------------------------------------------
.DS_Store
._*
Thumbs.db
*.swp
*~
.vscode/
.idea/
